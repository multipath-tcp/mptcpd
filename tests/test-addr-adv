#! /bin/bash
. "${srcdir:-$(dirname "$0")}/pm_lib.sh"

ep_has() {
	printf '%s\n' "$1" | awk -v a="$2" -v f="$3" '
		{ for (i=1; i+3 <= NF; i++)
			if ($i==a && $(i+1)=="id" && $(i+3)==f) found=1 }
		END { exit !found }'
}

pm_ep_check() {
	if ep_has "$2" "$3" "$4"; then
		pm_pass "$1: $3 ~ $4"
	else
		pm_fail "$1: expected $3 with $4"; fi
}

pm_test_addr_adv() {
	local ns1_ep
	local ns2_ep
	local subflows

	pm_start_mptcpd $PM_NS1 "addr_adv" "signal"
	pm_start_mptcpd $PM_NS2 "addr_adv" "subflow"

	sleep 1
	ns1_ep="$(ip -net "$PM_NS1" mptcp endpoint show)"
	ns2_ep="$(ip -net "$PM_NS2" mptcp endpoint show)"

	pm_ep_check "$PM_NS1" "$ns1_ep" 10.0.1.1 signal
	pm_ep_check "$PM_NS1" "$ns1_ep" 10.0.2.1 signal
	pm_ep_check "$PM_NS2" "$ns2_ep" 10.0.1.2 subflow
	pm_ep_check "$PM_NS2" "$ns2_ep" 10.0.2.2 subflow

	pm_do_conn "10.0.1.1" "5001"

	sleep 3
	subflows="$(ip netns exec "$PM_NS1" ss -Mit 2>/dev/null \
		    | grep -oE 'subflows:[0-9]+' | head -1 | cut -d: -f2)"
	if [ "${subflows:-0}" -eq 2 ]; then
		pm_pass "mptcp connection has $subflows subflows (>=2)"
	else
		pm_fail "expected >=2 subflows, got ${subflows:-0}"
	fi
}

pm_check_prereqs
pm_setup_env
pm_test_addr_adv
